{
  "name": "unidocs",
  "version": "1.0.0",
  "private": true,
  "description": "AHEU certificate management system: students request official certificates online, staff approve and sign them, anyone can verify them by QR code.",
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api"
  },
  "repository": {
    "type": "git",
    "url": "git+https://Kausarkizat@github.com/abiakma/unidocs.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/abiakma/unidocs/issues"
  },
  "homepage": "https://github.com/abiakma/unidocs#readme",
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.1"
  }
}
