# Copy to .env (repository root) and to apps/api/.env, then replace every "change-me" value.
# Never commit real .env files.

# ===== PostgreSQL (docker compose) =====
POSTGRES_USER=unidocs
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=unidocs
POSTGRES_PORT=5432

# ===== API =====
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://unidocs:change-me-local-db-password@localhost:5432/unidocs
# Public origin of the web app (used for CORS and login redirects).
WEB_BASE_URL=http://localhost:5173
# Base URL printed in QR codes: {VERIFICATION_BASE_URL}/verify/{token}
VERIFICATION_BASE_URL=http://localhost:5173
# Set to true behind HTTPS in production (adds the Secure flag to cookies).
COOKIE_SECURE=false
SESSION_TTL_HOURS=8
# Set to the number of trusted reverse proxies in front of the API (0 = none).
TRUST_PROXY_HOPS=0
STORAGE_DIR=./storage
CERTIFICATE_VALIDITY_DAYS=90

# ===== Integrations =====
# mock = fictional test identities (development only). platonus = official SSO (disabled until documented).
AUTH_PROVIDER=mock
# mock = fictional student data. platonus = official read-only API (disabled until documented).
STUDENT_DATA_PROVIDER=mock
# mock = TEST / NOT LEGALLY SIGNED documents. official = NCALayer / NCA RK (not implemented yet).
SIGNING_PROVIDER=mock

# Platonus placeholders: fill only with values from official university documentation.
PLATONUS_SSO_ISSUER_URL=
PLATONUS_SSO_CLIENT_ID=
PLATONUS_SSO_CLIENT_SECRET=
PLATONUS_SSO_REDIRECT_URI=
PLATONUS_API_BASE_URL=
PLATONUS_API_TOKEN=
PLATONUS_API_TIMEOUT_MS=5000
PLATONUS_API_MAX_RETRIES=2

# ===== Web (Vite) =====
# Where the Vite dev server proxies /api requests.
VITE_API_PROXY_TARGET=http://localhost:3000
